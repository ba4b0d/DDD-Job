# Required: secret used to sign JWTs (>= 32 chars recommended)
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# This file is loaded by docker compose when placed in the project root.
# For local dev, you can also set it as an environment variable:
#   export JWT_SECRET=$(python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=<generate-with-secrets-token-urlsafe-48>

# Comma-separated list of allowed CORS origins.
# When using the Docker nginx proxy, the frontend and backend are same-origin
# so CORS is not needed. Add origins only for direct dev-server access.
# Examples:
#   CORS_ORIGINS=http://localhost:5173,http://192.168.100.9:5173
CORS_ORIGINS=

# Set to 'true' when running behind HTTPS (Nginx/Caddy reverse proxy)
COOKIE_SECURE=false

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Telegram bot settings (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_PROXY=
